// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Not(in=a, out= i1);
    Not(in=b , out= i2);
    And(a= a, b= i2, out= j1);
    And(a= i1, b= b, out= j2);
    Or(a= j1, b= j2, out= out );
}